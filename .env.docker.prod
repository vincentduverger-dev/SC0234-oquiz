# DATABASE
POSTGRES_USER=oquiz
POSTGRES_PASSWORD=oquiz
POSTGRES_DB=oquiz
POSTGRES_PORT=5433

# API
DATABASE_URL=postgres://oquiz:oquiz@database:5432/oquiz
API_HOST_PORT=3333

# ADMINER
ADMINER_PORT=8080

# CLIENT
API_URL=http://localhost:3333/api
CLIENT_PORT=8000

# Maintenant qu'on on va faire un docker compose up, il va falloir lancer la commande avec l'option:
# --env-file .env.docker
# Exemple: docker compose --env-file .env.docker up -d
# Pour stopper docker-compose, il faudra faire :
# docker compose --env-file .env.docker down