    "passwordConfirm": "TestP@ss123",
    "email": "test@mail.fr"
  }
}

body:form-urlencoded {
  firstname: test
  lastname: test
  password: TestP@ss123
  passwordConfirm: TestP@ss123
  email: test@mail.com
}

settings {
  encodeUrl: true
  timeout: 0
}
