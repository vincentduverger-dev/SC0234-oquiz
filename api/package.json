{
  "name": "api",
  "type": "module",
  "scripts": {
    "======= Pour la prod =======": "========================",
    "start": "node dist/index.js",
    "build": "tsc",
    "docker:start": "npm run db:migrate:deploy && npm run start",
    "docker:dev": "npm run db:generate && npm run db:push && npm run dev",
    "======= Pour le dev ========": "========================",
    "dev": "tsx --watch index.ts",
    "======= Pour la BDD ========": "========================",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:seed": "tsx ./src/models/seeding.ts",
    "db:reset": "npm run db:migrate:reset && npm run db:seed",
    "db:studio": "prisma studio",
    "======= Pour les tests": "========================",
    "test:unit": "tsx --test ./**/*.unit.test.ts",
    "test:spec": "npx tsx --test --env-file=./test/config/.env.test --import ./test/config/global-setup.ts --experimental-test-isolation=none ./**/*.spec.test.ts",
    "test": "npm run test:unit && npm run test:spec",
    "======= BONUS": "========================",
    "eslint": "npx eslint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@prisma/client": "^6.11.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.12",
    "eslint": "^9.39.2",
    "prisma": "^6.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "sc02-oquiz": "file:..",
    "zod": "^4.3.6"
  }
}
